[Unit]
Description=Scraper noVNC gate (browser VNC; NOVNC_BIND in .env, loopback by default)
Requires=scraper-vnc.service
After=scraper-vnc.service tailscaled.service

[Service]
WorkingDirectory=%h/scraper
EnvironmentFile=-%h/scraper/.env
ExecStart=/usr/bin/node src/vnc-gate.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
