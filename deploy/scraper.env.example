# Copy into ~/scraper/.env (systemd EnvironmentFile; `npm run dev` reads it too).

# --- API ---
BIND_HOST=100.65.58.103
PORT=8787
# Shared secret the translation VM sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
API_TOKEN=

# --- Browser ---
# patchright (default) | extension
ENGINE=patchright
DISPLAY=:99
SCREEN_WIDTH=1600
SCREEN_HEIGHT=1000
# PROFILE_DIR=/home/mdm/scraper/data/chrome-profile   # engine name is appended
# EXTENSION_WS_PORT=8788                              # rerun scripts/build-inpage.js if changed

# --- Challenges ---
# Where you go to solve one by hand.
VNC_URL="http://100.65.58.103:6080/vnc.html?autoconnect=1&resize=scale"
# ntfy topic URL (e.g. https://ntfy.sh/<random-topic>) or a JSON webhook.
NOTIFY_URL=
NOTIFY_KIND=ntfy
# How long a blocked job waits for you before failing (ms).
CHALLENGE_TIMEOUT_MS=1800000

# --- Pacing defaults (per-site values live in the adapters / sites.json) ---
DEFAULT_DELAY_MS=2000

# --- Fallback (not wired up yet) ---
ZYTE_API_KEY=
