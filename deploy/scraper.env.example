# Copy into .env in the repo root (systemd EnvironmentFile; `npm run dev` reads it too).

# --- API ---
# Loopback by default. To reach the scraper from another machine, use that
# network's address here (a LAN or Tailscale IP), never a public one.
BIND_HOST=127.0.0.1
PORT=8787
# Shared secret the translation pipeline sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
API_TOKEN=

# --- Browser ---
# patchright (default) | extension
ENGINE=patchright
DISPLAY=:99
SCREEN_WIDTH=1600
SCREEN_HEIGHT=1000
# Open the browser at startup instead of on the first job (handy for setup).
# LAUNCH_ON_START=1
# Chromium instead of Google Chrome: CHROME_CHANNEL= and CHROME_PATH=/usr/bin/chromium
# PROFILE_DIR=~/scraper/data/chrome-profile          # engine name is appended
# EXTENSION_WS_PORT=8788                              # rerun scripts/build-inpage.js if changed

# --- Challenges ---
# Where you go to solve one by hand: the noVNC address as seen from your
# browser. NOVNC_BIND is the address scraper-novnc.service listens on.
NOVNC_BIND=127.0.0.1
VNC_URL="http://localhost:6080/vnc.html?autoconnect=1&resize=scale"
# ntfy topic URL (e.g. https://ntfy.sh/<random-topic>) or a JSON webhook.
NOTIFY_URL=
NOTIFY_KIND=ntfy
# json: HMAC-SHA256 key for the X-Scraper-Signature header (the secret itself
# is never sent). ntfy: access token for a protected topic (sent as Bearer).
# Use something other than API_TOKEN.
NOTIFY_SECRET=
# How long a blocked job waits for you before failing (ms).
CHALLENGE_TIMEOUT_MS=1800000
# POST /page captures (HTML/PNG) are deleted this many hours after capture; 0 = keep.
CAPTURE_TTL_HOURS=24

# --- NovelUpdates (POST /nu/*) ---
# The account releases are posted as, and our group's page
# (e.g. https://www.novelupdates.com/group/<slug>/).
NOVELUPDATES_LOGIN=
NOVELUPDATES_PASSWORD=
NOVELUPDATES_OUR_GROUP=

# --- Pacing defaults (per-site values live in the adapters / sites.json) ---
DEFAULT_DELAY_MS=2000

# --- Fallback (not wired up yet) ---
ZYTE_API_KEY=
