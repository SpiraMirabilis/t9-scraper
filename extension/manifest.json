{
  "manifest_version": 3,
  "name": "Scraper Bridge",
  "version": "0.1.0",
  "description": "Connects this browser to the local chapter scraper.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.twkan.com/*",
    "https://*.wfxs.tw/*",
    "https://*.novellunar.com/*",
    "https://*.69shuba.com/*",
    "https://*.novel543.com/*",
    "https://*.biquge.tw/*",
    "https://*.ixdzs8.com/*",
    "https://*.ixdzs.tw/*",
    "https://*.ixdzs.hk/*",
    "https://*.uukanshu.cc/*",
    "https://*.52shuku.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
