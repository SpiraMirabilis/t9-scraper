{
  "name": "chapter-scraper",
  "version": "0.2.0",
  "private": true,
  "description": "HTTP API that drives a real Chrome to scrape raw web-novel chapters on demand.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file=.env src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --import ./test/setup.js --test test/*.test.js"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7",
    "patchright": "^1.64.2",
    "ws": "^8.22.0"
  }
}
